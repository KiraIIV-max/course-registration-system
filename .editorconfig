
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.{xml,properties}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,jsx,ts,tsx,css,html}]
indent_size = 2

[*.bat]
end_of_line = crlf
